{
  "version": "1.0",
  "name": "国内教育类论文通用格式审核规则（示例）",
  "description": "基于常见国内教育类论文格式要求生成。硬约束为 error，建议项为 warning，可选或不确定项为 info/manual_review。",
  "defaults": {
    "tolerance": {
      "font_size_pt": 0.5,
      "line_spacing_pt": 0.2,
      "line_spacing_multiple": 0.05,
      "margin_cm": 0.1,
      "indent_chars": 0.2,
      "page_mm": 1.0
    }
  },
  "font_size_aliases": {
    "初号": 42.0,
    "小初": 36.0,
    "一号": 26.0,
    "小一": 24.0,
    "二号": 22.0,
    "小二": 18.0,
    "三号": 16.0,
    "小三": 15.0,
    "四号": 14.0,
    "小四": 12.0,
    "五号": 10.5,
    "小五": 9.0,
    "六号": 7.5,
    "小六": 6.5,
    "七号": 5.5,
    "八号": 5.0
  },
  "target_inference": {
    "heading_style_names": [
      "Heading 1",
      "Heading 2",
      "Heading 3",
      "标题 1",
      "标题 2",
      "标题 3",
      "heading1",
      "heading2",
      "heading3"
    ],
    "title_style_names": [
      "Title",
      "标题"
    ],
    "abstract_labels": [
      "摘要",
      "摘 要",
      "内容摘要",
      "摘要：",
      "摘 要："
    ],
    "keywords_labels": [
      "关键词",
      "关键字",
      "关键词：",
      "Keywords",
      "Key words"
    ],
    "references_labels": [
      "参考文献",
      "References",
      "引用文献"
    ],
    "appendix_labels": [
      "附录",
      "附 录",
      "Appendix"
    ],
    "acknowledgement_labels": [
      "致谢",
      "谢 辞",
      "Acknowledgements",
      "Acknowledgment"
    ],
    "figure_caption_regex": "^\\s*图\\s*\\d+(?:[-—_.．]\\d+)?(?:\\s|[：:.]).*$",
    "table_caption_regex": "^\\s*表\\s*\\d+(?:[-—_.．]\\d+)?(?:\\s|[：:.]).*$",
    "reference_entry_regex": "^\\s*\\[\\d+\\]",
    "in_text_citation_regex": "\\[(\\d{1,4}(?:[,，-]\\s*\\d{1,4})*)\\]"
  },
  "font_policy": {
    "allowed_fonts": [
      "宋体",
      "SimSun",
      "黑体",
      "SimHei",
      "楷体",
      "KaiTi",
      "Times New Roman",
      "Arial",
      "Calibri"
    ],
    "blocked_decorative_fonts": [
      "华文彩云",
      "方正舒体",
      "幼圆",
      "隶书",
      "艺术字",
      "华文行楷",
      "华文琥珀",
      "华文新魏"
    ]
  },
  "profiles": {
    "strict": {
      "overrides": [
        {
          "id": "body-line-spacing",
          "severity": "error"
        },
        {
          "id": "body-first-line-indent",
          "severity": "error"
        },
        {
          "id": "structure-order",
          "severity": "error"
        },
        {
          "id": "keyword-count",
          "severity": "error"
        }
      ],
      "disabled": []
    },
    "normal": {
      "overrides": [],
      "disabled": []
    },
    "loose": {
      "overrides": [],
      "disabled": [
        "cjk-latin-space",
        "abstract-length",
        "keyword-separator-style"
      ]
    }
  },
  "rules": [
    {
      "id": "page-a4",
      "enabled": true,
      "severity": "error",
      "manual_review": false,
      "message": "纸张应为 A4（210 × 297 mm）。",
      "suggestion": "在 Word 中进入“布局 → 纸张大小”，选择 A4。",
      "target": null,
      "type": "page_size",
      "expected": {
        "width_mm": 210.0,
        "height_mm": 297.0
      }
    },
    {
      "id": "page-margins",
      "enabled": true,
      "severity": "error",
      "manual_review": false,
      "message": "页边距应为：上 2.5 cm、下 2.5 cm、左 3.0 cm、右 2.5 cm。",
      "suggestion": "在 Word 中进入“布局 → 页边距 → 自定义页边距”进行调整。",
      "target": null,
      "type": "page_margins",
      "expected_cm": {
        "top_cm": 2.5,
        "bottom_cm": 2.5,
        "left_cm": 3.0,
        "right_cm": 2.5,
        "header_cm": null,
        "footer_cm": null,
        "gutter_cm": null
      }
    },
    {
      "id": "page-number-body-start",
      "enabled": true,
      "severity": "warning",
      "manual_review": true,
      "message": "正文通常应从第 1 页开始编页码，页码建议居中或右下角。当前版本仅提示人工确认。",
      "suggestion": "检查正文第一节是否重新从 1 开始编页码；页码位置是否符合学校要求。",
      "target": null,
      "type": "page_numbering",
      "expected": {
        "restart_at_body": true,
        "start": 1,
        "allowed_positions": [
          "center",
          "right_bottom"
        ]
      }
    },
    {
      "id": "body-font-size",
      "enabled": true,
      "severity": "error",
      "manual_review": false,
      "message": "正文字号应为小四（12 pt）。",
      "suggestion": "选中正文段落，将字号设置为小四（12 pt）。",
      "target": {
        "roles": [
          "body"
        ],
        "level": null,
        "exclude_roles": [],
        "tags": [],
        "text_regex": null
