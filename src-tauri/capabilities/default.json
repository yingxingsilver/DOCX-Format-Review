{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "论文格式批量审核系统主窗口能力：核心事件/命令 + 文件夹选择对话框 + 打开报告/文件",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url"
  ]
}
